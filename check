#!/usr/bin/env python3
"""./check — T-24h preflight. Exits 0 iff this machine is ready for the interview.

Verifies: python version, pytest importable, scaffold self-test (ledger/events/decisions),
harness self-tests, git identity, platform reachability (if ATTEMPT_TOKEN set), gateway reachability (optional).
"""
from __future__ import annotations

import importlib
import importlib.util
import json
import os
import shutil
import socket
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)
results: list[tuple[str, bool, str]] = []


def check(name: str, ok: bool, detail: str = "") -> None:
    results.append((name, ok, detail))
    print(f"[{'ok' if ok else 'FAIL'}] {name}" + (f" — {detail}" if detail else ""))


OFFLINE_STEPS = ("turn off VPN/proxy or use a phone hotspot and re-run ./check; or go offline: ask the interviewer for the pack file, "
                 "then ./interview offline <pack.tgz> (no network needed after that; hand in with ./interview handin)")


def connectivity(platform: str, token: str | None) -> tuple[bool, str]:
    """Probe the platform three ways so a failure says *where* it breaks: Python (what ./interview uses), curl (a second TLS
    stack — separates a Python/CA problem from a network block) and IPv4-only (some hotspots/VPNs break IPv6 to Cloudflare)."""
    base = platform.rstrip("/")
    parts = urllib.parse.urlsplit(base)
    host, port = parts.hostname or base, parts.port or 443
    url = f"{base}/api/cli/status" if token else f"{base}/healthz"
    hdr = {"User-Agent": "parkos-harness/1.0", **({"Authorization": f"Bearer {token}"} if token else {})}
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers=hdr), timeout=10) as resp:
            if resp.status == 200:
                return True, base if token else f"{base} (set ATTEMPT_TOKEN to verify your token too)"
            py = f"HTTP {resp.status}"
    except urllib.error.HTTPError as exc:
        return False, f"{exc.code} from {url} — wrong or expired ATTEMPT_TOKEN? ({exc.read()[:120].decode(errors='replace')})"
    except (urllib.error.URLError, OSError) as exc:
        py = str(exc.reason if isinstance(exc, urllib.error.URLError) else exc)
    # Python failed: run the cheap differential diagnostics.
    curl = "curl not installed"
    if shutil.which("curl"):
        r = subprocess.run(["curl", "-sS", "-o", "/dev/null", "-m", "10", "-w", "%{http_code}", f"{base}/healthz"], capture_output=True, text=True, check=False)
        curl = f"HTTP {r.stdout.strip()}" if r.returncode == 0 else (r.stderr.strip().splitlines() or ["failed"])[-1]
    try:
        v4 = socket.getaddrinfo(host, port, socket.AF_INET)[0][4][0]
        with socket.create_connection((v4, port), timeout=5):
            ipv4 = f"TCP to {v4}:{port} ok"
    except OSError as exc:
        ipv4 = f"TCP to {host}:{port} over IPv4 failed ({exc})"
    if curl.startswith("HTTP 200"):
        why = "Python cannot do TLS to the platform but curl can — a proxy/VPN or Python without CA certificates; "
    elif "ok" in ipv4:
        why = "TCP connects but TLS/HTTP does not — a VPN/proxy is intercepting the connection; "
    else:
        why = "nothing on this machine reaches the platform — the network blocks it; "
    return False, f"python: {py} · curl: {curl} · {ipv4}. {why}{OFFLINE_STEPS}"


def offline_mode() -> bool:
    state = os.path.join(ROOT, ".interview_state.json")
    if not os.path.exists(state):
        return False
    with open(state) as fh:
        try:
            return bool(json.load(fh).get("offline"))
        except json.JSONDecodeError:
            return False


def main() -> int:
    v = sys.version_info
    check("python >= 3.10", v >= (3, 10), f"{v.major}.{v.minor}.{v.micro}")
    try:
        importlib.import_module("pytest")
        check("pytest importable", True)
    except ImportError:
        check("pytest importable", False, "pip install -e '.[dev]'  (or use the container)")

    # Data-track roles (INTERVIEW_ROLE=mle) need pandas + numpy; for other roles this is informational only.
    role = os.environ.get("INTERVIEW_ROLE", "").lower()
    missing = [m for m in ("pandas", "numpy") if importlib.util.find_spec(m) is None]
    if role == "mle":
        check("pandas + numpy importable (MLE track)", not missing, "pip install -e '.[dev,data]'" if missing else "")
    elif missing:
        print(f"[note] pandas/numpy not installed ({', '.join(missing)}) — only needed for the MLE track (INTERVIEW_ROLE=mle)")

    try:
        from scaffold.decisions import Decision
        from scaffold.events import Event
        from scaffold.ledger import Ledger
        led = Ledger()
        led.assign_spot("A1", "ABC123", evidence=["e1"])
        led.record_payment("p1", "ABC123", 1800, evidence=["e2"])
        ev = Event.from_dict({"id": "e1", "type": "app.checkin", "ts": "2026-09-10T12:00:00Z", "source": "app",
                              "payload": {"spot": "A1", "plate": "ABC123"}})
        d = Decision(event_id=ev.id).add("assign_spot", spot="A1", plate="ABC123").to_dict()
        ok = (led.get_spot("A1").plate == "ABC123" and led.payments("ABC123")[0].amount == 1800
              and d["actions"][0]["spot"] == "A1" and len(led.history()) == 2)
        check("scaffold self-test", ok)
    except Exception as exc:  # noqa: BLE001
        check("scaffold self-test", False, repr(exc))

    tests = os.path.join(ROOT, "harness", "tests")
    if os.path.isdir(tests):
        r = subprocess.run([sys.executable, "-m", "pytest", "-q", "-p", "no:cacheprovider", tests],
                           cwd=ROOT, capture_output=True, text=True)
        check("harness self-tests", r.returncode == 0, r.stdout.strip().splitlines()[-1] if r.stdout.strip() else r.stderr[-200:])

    r = subprocess.run(["git", "config", "user.email"], cwd=ROOT, capture_output=True, text=True)
    check("git identity", bool(r.stdout.strip()), r.stdout.strip() or "git config user.email <you>")
    r = subprocess.run(["git", "rev-parse", "--is-inside-work-tree"], cwd=ROOT, capture_output=True, text=True)
    check("git repo", r.stdout.strip() == "true")

    from scaffold.events import ALL_SPOTS  # noqa: F401 - import path sanity
    check("problem/ empty (pack sealed)", not os.path.exists(os.path.join(ROOT, "problem", "pack.json")))

    platform = os.environ.get("PLATFORM_BASE_URL", "https://parkos.stationed.net")
    token = os.environ.get("ATTEMPT_TOKEN")
    if offline_mode():
        check("platform reachable", True, "skipped — this checkout is in offline mode (./interview offline)")
    else:
        ok, detail = connectivity(platform, token)
        check("platform reachable", ok, detail)

    gw = os.environ.get("MODEL_BASE_URL")
    if gw:
        try:
            req = urllib.request.Request(f"{gw.rstrip('/')}/healthz", headers={"User-Agent": "parkos-harness/1.0"})
            with urllib.request.urlopen(req, timeout=5) as resp:
                check("gateway reachable", resp.status == 200, gw)
        except (urllib.error.URLError, urllib.error.HTTPError) as exc:
            check("gateway reachable", False, str(exc))

    failed = [n for n, ok, _ in results if not ok]
    print("\nREADY" if not failed else f"\nNOT READY: {', '.join(failed)}")
    return 0 if not failed else 1


if __name__ == "__main__":
    sys.exit(main())
